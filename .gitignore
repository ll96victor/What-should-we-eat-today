# 上游菜谱原文缓存（构建脚本按需重新拉取，不入库）
tools/.cache/

# CloudBase 部署时临时整理出的站点目录，可由脚本随时重建
dist/

# 依赖（本项目无运行时依赖，防止误装）
node_modules/

# Claude Code 在项目内生成的临时产物
.claude/

# 临时文件
.tmpfiles/
*.log

# 画布工具运行时状态（cowart-selection / cowart-view-state 等本地画布状态）
canvas/

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# 微信开发者工具的本地私有配置（含本机路径与个人设置，不共享）
miniprogram/project.private.config.json

# 改动前的实现文件备份（my-coding-helper 工作流要求；git 已完整保存每个版本，故不入库避免重复）
history/
